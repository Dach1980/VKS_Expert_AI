        {
          "type": "clause",
          "number": "4.5",
          "level": 2,
          "text": "При проектировании следует учитывать климатическое районирование и особенности размещения объекта в соответствии с СП 131.13330.",
          "page_start": 5,
          "page_end": 5,
          "source": {
            "file": "D:\\Projects\\VKS_Expert_AI\\knowledge\\regulations\\СП_31.13330.2021\\СП_31.13330.2021_20260902_084832_463150.pdf",
