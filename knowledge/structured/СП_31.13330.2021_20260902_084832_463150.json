      "clauses": [
        {
          "type": "clause",
          "number": "4.1",
          "level": 2,
          "text": "При проектировании следует рассматривать целесообразность объединения систем водоснабжения объектов независимо от их ведомственной принадлежности с учетом положений [1], [2], [3]. Проектную и рабочую документацию следует выполнять с учетом требований ГОСТ Р 21.101, ГОСТ 21.704, СП 42.13330, СП 48.13330, СП 132.13330.",
          "page_start": 5,
          "page_end": 5,
          "source": {
            "file": "D:\\Projects\\VKS_Expert_AI\\knowledge\\regulations\\СП_31.13330.2021\\СП_31.13330.2021_20260902_084832_463150.pdf",
            "blocks": [
              {
                "page": 5,
                "bbox": [
                  70.8,
                  171.53,
                  555.608,
                  208.332
