        {
          "type": "clause",
          "number": "4.6",
          "level": 2,
          "text": "В части исполнения оборудование, аппараты, приборы и другие технические изделия должны соответствовать требованиям ГОСТ 15150.",
          "page_start": 5,
          "page_end": 5,
          "source": {
            "file": "D:\\Projects\\VKS_Expert_AI\\knowledge\\regulations\\СП_31.13330.2021\\СП_31.13330.2021_20260902_084832_463150.pdf",
