      "text": "Инв. №0039-20 35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1"
    },
    {
      "index": 2,
      "bbox": [
        23.28,
        808.664,
        417.718,
        826.157
      ],
      "text": "6 \n«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 3,
      "bbox": [
        227.34,
        41.4,
        342.48,
        57.372
      ],
      "text": "ɈȻɓɂȿ ȾȺɇɇɕȿ"
    },
    {
      "index": 4,
      "bbox": [
        77.88,
        73.176,
        531.394,
        91.518
      ],
      "text": "ɉɪɨɟɤɬɧɚɹ \nɞɨɤɭɦɟɧɬɚɰɢɢ \nɩɨ \nɨɛɴɟɤɬɭ: \n«ɉɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-"
    },
    {
      "index": 5,
      "bbox": [
        35.338,
        97.356,
        534.974,
        115.698
      ],
      "text": "ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɟ ɡɞɚɧɢɟ ɩɥɨɳɚɞɤɢ «Ɋɚɤɢɬɧɨɟ» ɪɚɡɪɚɛɨɬɚɧɚ ɧɚ ɨɫɧɨɜɚɧɢɢ"
    },
    {
      "index": 6,
      "bbox": [
        35.338,
        121.476,
        534.973,
        139.817
      ],
      "text": "ɞɨɝɨɜɨɪɚ №0000000035019Ɋ040002/111/20/ɋ/ɏȺȻ ɨɬ 24.04.2020 ɝ., ɡɚɤɥɸɱɟɧɧɨɝɨ"
    },
    {
      "index": 7,
      "bbox": [
        35.338,
        145.656,
        534.971,
        163.997
      ],
      "text": "ɦɟɠɞɭ ȺɈ «ɄɊȾȼ» ɢ ɈɈɈ «Ⱥɜɬɨɞɨɪɩɪɨɟɤɬ», ɜ ɫɨɨɬɜɟɬɫɬɜɢɢ ɫ ɩ. 1.7 ɡɚɞɚɧɢɹ ɧɚ"
    },
    {
      "index": 8,
      "bbox": [
        35.336,
        169.775,
        138.49,
        188.117
      ],
      "text": "ɩɪɨɟɤɬɢɪɨɜɚɧɢɟ."
    },
    {
      "index": 9,
      "bbox": [
        77.875,
        193.895,
        534.973,
        212.236
      ],
      "text": "ɈɈɈ «Ⱥɜɬɨɞɨɪɩɪɨɟɤɬ» ɨɫɭɳɟɫɬɜɥɹɟɬ ɫɜɨɸ ɞɟɹɬɟɥɶɧɨɫɬɶ ɩɨ ɩɨɞɝɨɬɨɜɤɟ"
    },
    {
      "index": 10,
      "bbox": [
        35.337,
        218.075,
        534.968,
        236.417
      ],
      "text": "ɩɪɨɟɤɬɧɨɣ ɞɨɤɭɦɟɧɬɚɰɢɢ ɧɚ ɨɫɧɨɜɚɧɢɢ ɱɥɟɧɫɬɜɚ ɜ ɫɚɦɨɪɟɝɭɥɢɪɭɟɦɨɣ ɨɪɝɚɧɢɡɚɰɢɢ"
    },
    {
      "index": 11,
      "bbox": [
        35.333,
        242.194,
        534.971,
        260.538
      ],
      "text": "(ɋɊɈ) Ⱥɋ «ɋɬɪɨɣɈɛɴɟɞɢɧɟɧɢɟ», ɪɟɝɢɫɬɪɚɰɢɨɧɧɵɣ ɧɨɦɟɪ ɜ ɪɟɟɫɬɪɟ ɱɥɟɧɨɜ"
    },
    {
      "index": 12,
      "bbox": [
        35.336,
        266.376,
        531.451,
        284.718
      ],
      "text": "171210/463, ɪɟɝɢɫɬɪɚɰɢɨɧɧɵɣ ɧɨɦɟɪ ɜ ɝɨɫɭɞɚɪɫɬɜɟɧɧɨɦ ɪɟɟɫɬɪɟ ɋɊɈ: №ɋɊɈ-ɉ-"
    },
    {
      "index": 13,
      "bbox": [
        35.335,
        293.862,
        123.98,
        307.842
      ],
      "text": "145-04032010."
    },
    {
      "index": 14,
      "bbox": [
        77.875,
        314.675,
        534.968,
        333.017
      ],
      "text": "Ɋɟɚɥɢɡɚɰɢɹ ɩɪɨɟɤɬɚ ɩɪɟɞɩɨɥɚɝɚɟɬɫɹ ɡɚ ɫɱɟɬ ɫɪɟɞɫɬɜ Ɏɟɞɟɪɚɥɶɧɨɝɨ"
    },
    {
      "index": 15,
      "bbox": [
        35.333,
        338.795,
        95.227,
        357.137
      ],
      "text": "ɛɸɞɠɟɬɚ."
    }
  ],
