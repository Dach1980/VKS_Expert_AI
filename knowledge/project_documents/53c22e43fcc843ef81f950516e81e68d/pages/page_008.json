        566.846,
        31.487
      ],
      "text": "ɚɬɟɝɨɪɢɢ \n35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1                                                                                          Инв. №0039-20"
    },
    {
      "index": 3,
      "bbox": [
        177.66,
        808.664,
        503.776,
        819.78
      ],
      "text": "«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 4,
      "bbox": [
        565.62,
        814.217,
        574.536,
        826.217
      ],
      "text": "7"
    },
    {
      "index": 5,
      "bbox": [
        94.2,
        41.29,
        532.44,
        59.898
      ],
      "text": "ɚ)  ɋɍɓȿɋɌȼɍɘɓɂȿ ɂ ɉɊɈȿɄɌɂɊɍȿɆɕȿ ɋɂɋɌȿɆɕ ɄȺɇȺɅɂɁȺɐɂɂ,"
    },
    {
      "index": 6,
      "bbox": [
        136.26,
        65.58,
        490.44,
        81.552
      ],
      "text": "ȼɈȾɈɈɌȼȿȾȿɇɂə ɂ ɋɌȺɇɐɂɂ ɈɑɂɋɌɄɂ ɋɌɈɑɇɕɏ ȼɈȾ"
    },
    {
      "index": 7,
      "bbox": [
        106.32,
        104.256,
        563.412,
        122.598
      ],
      "text": "ȼɨɞɨɨɬɜɟɞɟɧɢɟ ɨɬ ɩɪɨɟɤɬɢɪɭɟɦɨɝɨ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɝɨ"
    },
    {
      "index": 8,
      "bbox": [
        63.776,
        128.376,
        563.415,
        146.718
      ],
      "text": "ɡɞɚɧɢɹ ɢ ɡɞɚɧɢɹ Ʉɉɉ ɩɥɨɳɚɞɤɢ «Ɋɚɤɢɬɧɨɟ»  ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ, ɫɨɝɥɚɫɧɨ"
    },
    {
      "index": 9,
      "bbox": [
        63.779,
        152.556,
        563.411,
        170.897
      ],
      "text": "ɬɟɯɧɢɱɟɫɤɢɯ ɭɫɥɨɜɢɣ ɧɚ ɩɨɞɤɥɸɱɟɧɢɟ  № Ɍɍ-103/ȼ  ɨɬ 31.07.2020ɝ., ɜɵɞɚɧɧɵɯ"
    },
    {
      "index": 10,
      "bbox": [
        63.776,
        176.675,
        563.413,
        195.017
      ],
      "text": "ȺɈ «ɄɊȾȼ», ɜ ɩɪɨɟɤɬɢɪɭɟɦɭɸ ɜɧɭɬɪɢɩɥɨɳɚɞɨɱɧɭɸ ɫɟɬɶ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ"
    },
    {
      "index": 11,
      "bbox": [
        63.777,
        171.598,
        563.415,
        249.592
      ],
      "text": "∅160 ɦɦ ɜ ɝɪɚɧɢɰɚɯ ɡɟɦɟɥɶɧɨɝɨ  ɭɱɚɫɬɤɚ ɫ ɩɨɫɥɟɞɭɸɳɢɦ ɨɬɜɟɞɟɧɢɟɦ ɫɬɨɤɨɜ ɩɨ"
    },
    {
      "index": 12,
      "bbox": [
        63.78,
        196.259,
        563.414,
        274.253
      ],
      "text": "ɜɧɟɩɥɨɳɚɞɨɱɧɨɣ ɫɟɬɢ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ∅160 ɜ ɛɥɢɠɚɣɲɢɣ  ɤɨɥɨɞɟɰ"
    },
    {
      "index": 13,
      "bbox": [
        63.779,
        220.858,
        563.417,
        298.853
      ],
      "text": "ɩɪɨɟɤɬɢɪɭɟɦɨɣ ɝɨɪɨɞɫɤɨɣ ɫɟɬɢ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ  ∅250 ɦɦ ɢ ɞɚɥɟɟ ɧɚ"
    },
    {
      "index": 14,
      "bbox": [
        63.782,
        274.656,
        559.898,
        292.998
      ],
      "text": "ɝɨɪɨɞɫɤɢɟ ɨɱɢɫɬɧɵɟ ɫɨɨɪɭɠɟɧɢɹ, ɫɦ. ɩɨɞɪɚɡɞɟɥ 35020Ɋ040002.111.20.ɋ.ɏȺȻ-"
    },
    {
      "index": 15,
      "bbox": [
        63.783,
        298.836,
        117.857,
        317.178
      ],
      "text": "ɂɈɋ3.2."
    },
    {
      "index": 16,
      "bbox": [
        85.082,
        322.956,
        540.318,
        341.297
      ],
      "text": "ɋɬɚɧɰɢɢ ɨɱɢɫɬɤɢ ɫɬɨɱɧɵɯ ɜɨɞ ɧɟ ɩɪɟɞɭɫɦɚɬɪɢɜɚɸɬɫɹ, ɬ.ɤ. ɨɬɜɨɞ ɛɵɬɨɜɵɯ"
    },
    {
      "index": 17,
      "bbox": [
        63.784,
        347.135,
        542.296,
        365.477
      ],
      "text": "ɫɬɨɱɧɵɯ ɜɨɞ ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ ɜ ɫɭɳɟɫɬɜɭɸɳɢɟ ɝɨɪɨɞɫɤɢɟ ɫɟɬɢ ɨɞɧɨɢɦɟɧɧɨɣ"
    },
    {
      "index": 18,
      "bbox": [
        63.781,
        371.255,
        526.394,
        389.597
      ],
      "text": "ɤɚɧɚɥɢɡɚɰɢɢ ɫ ɩɨɫɥɟɞɭɸɳɟɣ ɨɱɢɫɬɤɨɣ ɧɚ ɝɨɪɨɞɫɤɢɯ ɨɱɢɫɬɧɵɯ ɫɨɨɪɭɠɟɧɢɹɯ."
    },
    {
      "index": 19,
      "bbox": [
        85.078,
        395.435,
        492.853,
        413.777
      ],
      "text": "ȼ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɦ ɡɞɚɧɢɢ  ɩɪɟɞɭɫɦɚɬɪɢɜɚɸɬɫɹ"
    },
    {
      "index": 20,
      "bbox": [
        63.777,
        419.555,
        272.594,
        437.898
      ],
      "text": "ɫɥɟɞɭɸɳɢɟ ɫɢɫɬɟɦɵ ɤɚɧɚɥɢɡɚɰɢɢ:"
    },
    {
      "index": 21,
      "bbox": [
        85.077,
        443.736,
        258.973,
        462.078
      ],
      "text": "-  ɛɵɬɨɜɚɹ ɤɚɧɚɥɢɡɚɰɢɹ - Ʉ1;"
    },
    {
      "index": 22,
      "bbox": [
        85.075,
        467.856,
        271.508,
        486.197
      ],
      "text": "-  ɜɧɭɬɪɟɧɧɢɟ ɜɨɞɨɫɬɨɤɢ  – Ʉ2."
    },
    {
      "index": 23,
      "bbox": [
        85.074,
        492.035,
        501.125,
        510.377
      ],
      "text": "ȼ ɡɞɚɧɢɢ Ʉɉɉ ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ ɫɢɫɬɟɦɚ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ Ʉ1."
    },
    {
      "index": 25,
      "bbox": [
        64.495,
        543.97,
        562.135,
        576.132
      ],
      "text": "ɛ)  ɈȻɈɋɇɈȼȺɇɂȿ ɉɊɂɇəɌɕɏ ɋɂɋɌȿɆ ɋȻɈɊȺ ɂ ɈɌȼɈȾȺ ɋɌɈɑɇɕɏ ȼɈȾ, \nɄɈɇɐȿɇɌɊȺɐɂɃ ɂɏ ɁȺȽɊəɁɇȿɇɂə, ɋɉɈɋɈȻɈȼ ɉɊȿȾȼȺɊɂɌȿɅɖɇɈɃ ɈɑɂɋɌɄɂ,"
    },
    {
      "index": 26,
      "bbox": [
        71.695,
        573.96,
        554.934,
        589.932
      ],
      "text": "ɉɊɂɆȿɇəȿɆɕɏ ɋɂɋɌȿɆ ɋȻɈɊȺ ɂ ɈɌȼɈȾȺ ɋɌɈɑɇɕɏ ȼɈȾ, ɄɈɇɐȿɇɌɊȺɐɂɃ"
    },
    {
      "index": 27,
      "bbox": [
        77.754,
        587.76,
        548.933,
        603.732
      ],
      "text": "ɊȿȺȽȿɇɌɈȼ, ɈȻɈɊɍȾɈȼȺɇɂə ɂ ȺɉɉȺɊȺɌɍɊɕ ɈɑɂɋɌɄɂ,   ɉɊɂɆȿɇəȿɆɕɏ"
    },
    {
      "index": 28,
      "bbox": [
        167.873,
        601.56,
        458.753,
        617.532
      ],
      "text": "ɊȿȺȽȿɇɌɈȼ, ɈȻɈɊɍȾɈȼȺɇɂə ɂ ȺɉɉȺɊȺɌɍɊɕ"
    },
    {
      "index": 30,
      "bbox": [
        63.773,
        651.456,
        566.889,
        669.798
      ],
      "text": "Ȼɵɬɨɜɵɟ ɫɬɨɤɢ ɨɬ ɩɪɢɛɨɪɨɜ ɜ ɫɚɧɭɡɥɚɯ ɢ Ʉɍɂ, ɨɬ ɬɪɚɩɨɜ ɬɟɯɧɢɱɟɫɤɢɯ ɢ"
    },
    {
      "index": 31,
      "bbox": [
        63.774,
        675.636,
        566.95,
        693.977
      ],
      "text": "ɞɭɲɟɜɵɯ ɩɨɦɟɳɟɧɢɣ, ɚ ɬɚɤɠɟ ɨɬ ɨɩɨɪɨɠɧɟɧɢɹ ɫɟɬɟɣ ɜɨɞɨɫɧɚɛɠɟɧɢɹ ɢ ɨɬɨɩɥɟɧɢɹ"
    },
    {
      "index": 32,
      "bbox": [
        63.774,
        699.755,
        563.409,
        718.097
      ],
      "text": "ɜ ɤɨɥɢɱɟɫɬɜɟ 3,58 ɥ/ɫ, 4,34 ɦ3/ɱ, 8,48 ɦ3/ɫɭɬ ɨɬɜɨɞɹɬɫɹ ɫɢɫɬɟɦɨɣ ɜɧɭɬɪɟɧɧɟɣ"
    },
    {
      "index": 33,
      "bbox": [
        63.773,
        694.738,
        563.409,
        772.732
      ],
      "text": "ɫɚɦɨɬɟɱɧɨɣ \nɛɵɬɨɜɨɣ \nɤɚɧɚɥɢɡɚɰɢɢ \nɩɨ \nɩɹɬɢ \nɜɵɩɭɫɤɚɦ \n∅110ɦɦ \nɜ"
    },
    {
      "index": 34,
      "bbox": [
        63.774,
        719.339,
        427.129,
        797.333
      ],
      "text": "ɜɧɭɬɪɢɩɥɨɳɚɞɨɱɧɭɸ ɫɟɬɶ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ  ∅160 ɦɦ."
    }
  ],
  "formulas": []
}