        31.487
      ],
      "text": "ɚɬɟɝɨɪɢɢ \n35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1                                                                                          Инв. №0039-20"
    },
    {
      "index": 3,
      "bbox": [
        177.66,
        808.664,
        503.776,
        819.78
      ],
      "text": "«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 4,
      "bbox": [
        560.1,
        814.217,
        574.536,
        826.217
      ],
      "text": "11"
    },
    {
      "index": 5,
      "bbox": [
        106.32,
        41.376,
        534.513,
        59.718
      ],
      "text": "Ⱦɥɹ ɨɬɜɨɞɚ ɞɨɠɞɟɜɵɯ ɢ ɬɚɥɵɯ ɜɨɞ ɫɨ ɫɤɚɬɧɨɣ ɤɪɨɜɥɢ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-"
    },
    {
      "index": 6,
      "bbox": [
        63.777,
        65.556,
        530.471,
        83.898
      ],
      "text": "ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɝɨ ɡɞɚɧɢɹ ɩɪɟɞɭɫɦɨɬɪɟɧɚ ɫɢɫɬɟɦɚ ɜɧɭɬɪɟɧɧɢɯ  ɜɨɞɨɫɬɨɤɨɜ ɫ"
    },
    {
      "index": 7,
      "bbox": [
        63.776,
        60.478,
        558.368,
        138.473
      ],
      "text": "ɨɞɧɢɦ ɡɚɤɪɵɬɵɦ ɜɵɩɭɫɤɨɦ ∅200ɦɦ ɩɨ ɨɫɢ «Ⱦ» ɢ ɫɢɫɬɟɦɚ ɧɚɪɭɠɧɵɯ ɜɨɞɨɫɬɨɤɨɜ ɫ"
    },
    {
      "index": 8,
      "bbox": [
        63.772,
        114.276,
        553.084,
        132.618
      ],
      "text": "ɜɵɩɭɫɤɚɦɢ ɧɚ ɨɬɦɨɫɬɤɭ ɜ ȺȻɄ ɢ ɩɨ ɨɫɹɦ «Ⱥ» ɢ «Ʉ» ɜ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨɣ ɱɚɫɬɢ. ȼ"
    },
    {
      "index": 9,
      "bbox": [
        63.769,
        138.456,
        527.532,
        156.798
      ],
      "text": "ɡɞɚɧɢɢ Ʉɉɉ ɩɪɢɧɹɬ ɧɚɪɭɠɧɵɣ ɜɨɞɨɫɬɨɤ. ɉɪɨɟɤɬɧɵɟ ɪɟɲɟɧɢɹ ɩɨ ɧɚɪɭɠɧɨɦɭ"
    },
    {
      "index": 10,
      "bbox": [
        63.776,
        162.576,
        498.617,
        180.917
      ],
      "text": "ɜɨɞɨɫɬɨɤɭ ɫɦ. ɪɚɡɞɟɥ 35020Ɋ040002.111.20.ɋ.ɏȺȻ-ȺɊ (ɢɧɜ.№0030-20)."
    },
    {
      "index": 11,
      "bbox": [
        106.318,
        186.756,
        548.65,
        205.098
      ],
      "text": "ȼɨɞɨɫɬɨɱɧɵɟ ɜɨɪɨɧɤɢ ɧɚ ɤɪɨɜɥɟ ɜ ɟɧɞɨɜɟ ɩɨ ɨɫɢ «Ⱦ» ɜ ɤɨɥɢɱɟɫɬɜɟ 6 ɲɬ."
    },
    {
      "index": 12,
      "bbox": [
        63.777,
        210.876,
        550.031,
        229.217
      ],
      "text": "ɩɪɢɧɹɬɵ ɬɢɩɚ ȼɎɈ-160-175 ɫ ɷɥɟɤɬɪɨɨɛɨɝɪɟɜɨɦ, ɦɨɳɧɨɫɬɶ ɫɚɦɨɪɟɝɭɥɢɪɭɸɳɟɝɨ"
    },
    {
      "index": 13,
      "bbox": [
        63.776,
        235.055,
        251.599,
        253.397
      ],
      "text": "ɤɚɛɟɥɹ - 23ȼɬ (ɧɚ 1 ɜɨɪɨɧɤɭ)."
    },
    {
      "index": 14,
      "bbox": [
        106.314,
        259.175,
        563.411,
        277.517
      ],
      "text": "ȼɧɭɬɪɟɧɧɢɣ ɜɨɞɨɫɬɨɤ ɦɨɧɬɢɪɭɟɬɫɹ  ɢɡ ɬɪɭɛɵ ɫɬɚɥɶɧɨɣ ɛɟɫɲɨɜɧɨɣ"
    },
    {
      "index": 15,
      "bbox": [
        63.776,
        283.355,
        563.408,
        301.697
      ],
      "text": "d=219ɯ6,0 ɦɦ  ɩɨ ȽɈɋɌ 8732-78 (ɋɬ. 09Ƚ2ɋ) ɫ ɜɧɭɬɪɟɧɧɢɦ ɩɨɥɢɦɟɪɧɵɢ"
    },
    {
      "index": 16,
      "bbox": [
        63.773,
        307.474,
        563.406,
        325.816
      ],
      "text": "ɩɨɤɪɵɬɢɟɦ ɩɨ Ɍɍ 1390-002-48276800-2015. ɇɚɪɭɠɧɚɹ ɩɨɜɟɪɯɧɨɫɬɶ ɫɬɚɥɶɧɵɯ"
    },
    {
      "index": 17,
      "bbox": [
        63.771,
        331.655,
        563.417,
        349.997
      ],
      "text": "ɬɪɭɛɨɩɪɨɜɨɞɨɜ ɜ ɰɟɥɹɯ ɡɚɳɢɬɵ ɨɬ ɤɨɪɪɨɡɢɢ  ɨɤɪɚɲɢɜɚɟɬɫɹ ɦɚɫɥɹɧɨɣ ɤɪɚɫɤɨɣ ɡɚ"
    },
    {
      "index": 18,
      "bbox": [
        63.782,
        355.776,
        563.416,
        374.117
      ],
      "text": "ɞɜɚ ɪɚɡɚ. ȼɧɭɬɪɟɧɧɢɣ ɜɨɞɨɫɬɨɤ ɩɪɨɤɥɚɞɵɜɚɟɬɫɹ ɨɬɤɪɵɬɨ ɩɨɞ ɩɟɪɟɤɪɵɬɢɟɦ ɫ"
    },
    {
      "index": 19,
      "bbox": [
        63.781,
        379.955,
        563.415,
        398.297
      ],
      "text": "ɤɪɟɩɥɟɧɢɟɦ ɤ ɫɬɪɨɢɬɟɥɶɧɵɦ ɤɨɧɫɬɪɭɤɰɢɹɦ – ɤɨɥɨɧɧɚɦ ɢ ɮɟɪɦɚɦ. ɍɫɬɚɧɨɜɤɚ"
    },
    {
      "index": 20,
      "bbox": [
        63.779,
        404.075,
        563.405,
        422.417
      ],
      "text": "ɪɟɜɢɡɢɣ ɢ ɩɪɨɱɢɫɬɨɤ ɧɚ ɜɨɞɨɫɬɨɱɧɨɣ ɫɢɫɬɟɦɟ ɜɵɩɨɥɧɟɧɚ ɫɨɝɥɚɫɧɨ ɩ.ɩ.8.2.23,"
    },
    {
      "index": 21,
      "bbox": [
        63.778,
        428.195,
        216.231,
        446.536
      ],
      "text": "8.2.24 ɋɉ 30.13330.2012."
    },
    {
      "index": 22,
      "bbox": [
        106.319,
        452.374,
        563.418,
        470.716
      ],
      "text": "Ɋɚɫɱɟɬɧɵɣ ɪɚɫɯɨɞ ɞɨɠɞɟɜɵɯ ɜɨɞ ɫ ɤɪɨɜɥɢ ɡɞɚɧɢɹ ɨɩɪɟɞɟɥɟɧ, ɫɨɝɥɚɫɧɨ"
    },
    {
      "index": 23,
      "bbox": [
        63.782,
        476.494,
        563.415,
        494.838
      ],
      "text": "ɩ.8.7.9 ɋɉ30.13330.2016 ɢ ɫɨɫɬɚɜɥɹɟɬ 38,74 ɥ/ɫ ɩɨ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨɣ ɱɚɫɬɢ ɡɞɚɧɢɹ,"
    },
    {
      "index": 24,
      "bbox": [
        63.781,
        500.676,
        545.538,
        519.017
      ],
      "text": "ɢɡ ɧɢɯ 18,23ɥ/ɫ - ɜɧɭɬɪɟɧɧɢɣ ɜɨɞɨɫɬɨɤ ɢ 6,81ɥ/ɫ  ɫ ɤɪɨɜɥɢ ȺȻɄ, ɜɫɟɝɨ - 45,55ɥ/ɫ."
    },
    {
      "index": 25,
      "bbox": [
        106.323,
        524.795,
        563.421,
        543.137
      ],
      "text": "ɉɪɨɟɤɬɧɵɟ ɪɟɲɟɧɢɹ ɩɨ ɩɪɨɤɥɚɞɤɟ ɜɧɭɬɪɢ ɢ ɜɧɟɩɥɨɳɚɞɨɱɧɵɯ ɫɟɬɟɣ"
    },
    {
      "index": 26,
      "bbox": [
        63.786,
        548.975,
        563.422,
        567.317
      ],
      "text": "ɞɨɠɞɟɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɩɥɨɳɚɞɤɢ «Ɋɚɤɢɬɧɨɟ» ɢ ɩɨ ɨɛɴɟɦɭ ɞɨɠɞɟɜɨɝɨ ɫɬɨɤɚ ɫ"
    },
    {
      "index": 27,
      "bbox": [
        63.787,
        573.095,
        521.78,
        591.436
      ],
      "text": "ɬɟɪɪɢɬɨɪɢɢ ɫɦ. ɱɚɫɬɶ 35020Ɋ040002.111.20.ɋ.ɏȺȻ-ɂɈɋ3.2 (ɢɧɜ.№0040-20)."
    },
    {
      "index": 29,
      "bbox": [
        147.488,
        645.31,
        479.163,
        663.917
      ],
      "text": "ɟ)  Ɋȿɒȿɇɂə ɉɈ ɋȻɈɊɍ ɂ ɈɌȼɈȾɍ ȾɊȿɇȺɀɇɕɏ ȼɈȾ"
    },
    {
      "index": 31,
      "bbox": [
        85.023,
        687.275,
        563.421,
        705.617
      ],
      "text": "Ⱦɪɟɧɚɠ \nɩɪɨɟɤɬɧɨɣ \nɞɨɤɭɦɟɧɬɚɰɢɟɣ \nɢ \nɬɟɯɧɢɱɟɫɤɢɦ \nɡɚɞɚɧɢɟɦ \nɧɟ"
    },
    {
      "index": 32,
      "bbox": [
        63.785,
        711.455,
        185.299,
        729.797
      ],
      "text": "ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ."
    }
  ],
  "formulas": []
}