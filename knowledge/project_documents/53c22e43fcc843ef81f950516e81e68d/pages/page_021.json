    {
      "index": 40,
      "bbox": [
        1140.683,
        839.137,
        1644.715,
        940.087
      ],
      "text": "ɉɪɢɦɟɱɚɧɢɹ:\n1.  Ɇɨɧɬɚɠ\u0003ɬɪɭɛ\u0003ɤɚɧɚɥɢɡɚɰɢɨɧɧɨɣ\u0003ɫɟɬɢ\u0003ɜɵɩɨɥɧɹɬɶ, ɢɫɩɨɥɶɡɭɹ\u0003ɤɨɫɵɟ\u0003ɬɪɨɣɧɢɤɢ, ɤɪɟɫɬɨɜɢɧɵ,\nɨɬɜɨɞɵ, ɩɨɞɤɥɸɱɟɧɢɟ\u0003ɤ\u0003ɫɟɬɢ\u0003ɜɫɟɯ\u0003ɨɬɜɨɞɨɜ\u0003ɩɨɞ\u0003\u001c\u0013\u0003ɢ\u0003ɩɨɜɨɪɨɬɵ\u0003ɫɟɬɢ\u0003ɩɨɞ\u0003\u001c\u0013\u0003ɞɨɥɠɧɵ\nɜɵɩɨɥɧɹɬɶɫɹ\u0003ɩɥɚɜɧɨ\u0003ɧɚ\u00032-ɯ\u0003ɨɬɜɨɞɚɯ.\n2.  ɇɚ\u0003ɫɯɟɦɚɯ\u0003ɞɚɧɵ\u0003ɨɬɦɟɬɤɢ\u0003ɧɢɡɚ\u0003ɬɪɭɛɨɩɪɨɜɨɞɨɜ.\n3. ɉɪɢ\u0003ɩɟɪɟɫɟɱɟɧɢɢ\u0003ɫɬɨɹɤɚɦɢ\u0003\u0003ɩɥɢɬ\u0003ɩɟɪɟɤɪɵɬɢɣ\u0003\u0003\u0003ɭɫɬɚɧɨɜɢɬɶ\u0003 (ɩɨɞ\u0003ɩɟɪɟɤɪɵɬɢɟɦ)\nɩɪɨɬɢɜɨɩɨɠɚɪɧɵɟ\u0003ɦɭɮɬɵ."
    },
    {
      "index": 41,
      "bbox": [
        1141.157,
        938.618,
        1660.399,
        1011.608
      ],
      "text": "4. Ɇɟɫɬɚ\u0003ɩɪɨɯɨɞɚ\u0003ɫɬɨɹɤɨɜ, (ɩɟɪɟɞ\u0003ɭɫɬɚɧɨɜɤɨɣ\u0003ɩɪɨɬɢɜɨɩɨɠɚɪɧɵɯ\u0003ɦɭɮɬ), ɡɚɞɟɥɚɬɶ\u0003\u0003ɰɟɦɟɧɬɧɵɦ\nɪɚɫɬɜɨɪɨɦ, ɫɬɨɹɤ\u0003\u0003ɨɛɟɪɧɭɬɶ\u0003ɪɭɥɨɧɧɵɦ\u0003ɝɢɞɪɨɢɡɨɥɹɰɢɨɧɧɵɦ\u0003\u0003ɦɚɬɟɪɢɚɥɨɦ\u0003ɛɟɡ\u0003ɡɚɡɨɪɚ .\n5.  Ⱦɥɹ\u0003ɤɨɦɩɟɧɫɚɰɢɢ\u0003ɫɬɪɨɢɬɟɥɶɧɵɯ\u0003ɞɨɩɭɫɤɨɜ, ɭɩɪɨɳɟɧɢɹ\u0003\u0003ɦɨɧɬɚɠɧɨ-ɫɛɨɪɨɱɧɵɯ\u0003ɢ\u0003ɪɟɦɨɧɬɧɵɯ\nɪɚɛɨɬ\u0003ɧɚ\u0003ɤɚɧɚɥɢɡɚɰɢɨɧɧɵɯ\u0003ɫɬɨɹɤɚɯ\u0003ɩɪɟɞɭɫɦɨɬɪɟɧɵ\u0003ɤɨɦɩɟɧɫɚɰɢɨɧɧɵɟ\u0003ɩɚɬɪɭɛɤɢ\u0003ɫ\u0003ɭɞɥɢɧɟɧɧɵɦ\nɪɚɫɬɪɭɛɨɦ\u0003ɧɚ\u0003ɤɚɠɞɨɦ\u0003ɷɬɚɠɟ."
    },
