      ],
      "text": "ɋɨɞɟɪɠɚɧɢɟ ........................................................................................................................ 3"
    },
    {
      "index": 8,
      "bbox": [
        63.781,
        121.476,
        569.122,
        139.817
      ],
      "text": "ɋɨɫɬɚɜ ɩɨɞɪɚɡɞɟɥɚ ............................................................................................................. 5"
    },
    {
      "index": 9,
      "bbox": [
        63.78,
        145.656,
        551.794,
        163.997
      ],
      "text": "Ɉɛɳɢɟ ɞɚɧɧɵɟ………………………………………………………………………   5"
    },
    {
      "index": 10,
      "bbox": [
        63.781,
        169.775,
        570.559,
        188.117
      ],
      "text": "ɚ) ɋɭɳɟɫɬɜɭɸɳɢɟ ɢ ɩɪɨɟɤɬɢɪɭɟɦɵɟ ɫɢɫɬɟɦɵ ɤɚɧɚɥɢɡɚɰɢɢ, ɜɨɞɨɨɬɜɟɞɟɧɢɹ ɢ"
    },
    {
      "index": 11,
      "bbox": [
        63.784,
        193.895,
        568.724,
        212.25
      ],
      "text": "ɫɬɚɧɰɢɢ ɨɱɢɫɬɤɢ ɫɬɨɱɧɵɯ ɜɨɞ .......................................................................................... 7"
    },
    {
      "index": 12,
      "bbox": [
        63.784,
        218.075,
        549.435,
        236.417
      ],
      "text": "ɛ)  Ɉɛɨɫɧɨɜɚɧɢɟ ɩɪɢɧɹɬɵɯ ɫɢɫɬɟɦ ɫɛɨɪɚ ɢ ɨɬɜɨɞɚ ɫɬɨɱɧɵɯ ɜɨɞ, ɤɨɧɰɟɧɬɪɚɰɢɹ ɢɯ"
    },
    {
      "index": 13,
      "bbox": [
        63.779,
        242.194,
        540.615,
        260.536
      ],
      "text": "ɡɚɝɪɹɡɧɟɧɢɹ, ɫɩɨɫɨɛɨɜ ɩɪɟɞɜɚɪɢɬɟɥɶɧɨɣ ɨɱɢɫɬɤɢ, ɩɪɢɦɟɧɹɟɦɵɯ ɫɢɫɬɟɦ ɫɛɨɪɚ ɢ"
    },
    {
      "index": 14,
      "bbox": [
        63.779,
        266.374,
        568.718,
        284.73
      ],
      "text": "ɨɬɜɨɞɚ ɫɬɨɱɧɵɯ ɜɨɞ, ɤɨɧɰɟɧɬɪɚɰɢɢ ɪɟɚɝɟɧɬɨɜ, ɨɛɨɪɭɞɨɜɚɧɢɹ ɢ ɚɩɩɚɪɚɬɭɪɵ ............. 7"
    },
    {
      "index": 15,
      "bbox": [
        63.779,
        290.494,
        568.718,
        308.852
      ],
      "text": "ɜ)  Ɉɛɨɫɧɨɜɚɧɢɟ ɩɪɢɧɹɬɨɝɨ ɩɨɪɹɞɤɚ ɫɛɨɪɚ, ɭɬɢɥɢɡɚɰɢɢ ɢ ɡɚɯɨɪɨɧɟɧɢɹ ɨɬɯɨɞɨɜ ....... 8"
    },
    {
      "index": 16,
      "bbox": [
        63.779,
        314.676,
        548.231,
        333.018
      ],
      "text": "ɝ)  Ɉɩɢɫɚɧɢɟ ɢ ɨɛɨɫɧɨɜɚɧɢɟ ɫɯɟɦɵ ɩɪɨɤɥɚɞɤɢ ɤɚɧɚɥɢɡɚɰɢɨɧɧɵɯ ɬɪɭɛɨɩɪɨɜɨɞɨɜ,"
    },
    {
      "index": 17,
      "bbox": [
        63.777,
        338.795,
        563.229,
        357.137
      ],
      "text": "ɨɩɢɫɚɧɢɟ ɭɱɚɫɬɤɨɜ ɩɪɨɤɥɚɞɤɢ ɧɚɩɨɪɧɵɯ ɬɪɭɛɨɩɪɨɜɨɞɨɜ (ɩɪɢ ɧɚɥɢɱɢɢ), ɭɫɥɨɜɢɹ ɢɯ"
    },
    {
      "index": 18,
      "bbox": [
        63.774,
        362.975,
        523.328,
        381.317
      ],
      "text": "ɩɪɨɤɥɚɞɤɢ, ɨɛɨɪɭɞɨɜɚɧɢɟ, ɫɜɟɞɟɧɢɹ ɨ ɦɚɬɟɪɢɚɥɟ ɬɪɭɛɨɩɪɨɜɨɞɨɜ ɢ ɤɨɥɨɞɰɟɜ,"
    },
    {
      "index": 19,
      "bbox": [
        63.773,
        387.095,
        561.388,
        405.451
      ],
      "text": "ɫɩɨɫɨɛɵ ɢɯ ɡɚɳɢɬɵ ɨɬ ɚɝɪɟɫɫɢɜɧɨɝɨ ɜɨɡɞɟɣɫɬɜɢɹ ɝɪɭɧɬɨɜ ɢ ɝɪɭɧɬɨɜɵɯ ɜɨɞ  ……  8"
    },
    {
      "index": 20,
      "bbox": [
        63.769,
        411.275,
        547.754,
        429.618
      ],
      "text": "ɞ)  Ɋɟɲɟɧɢɹ ɜ ɨɬɧɨɲɟɧɢɢ ɥɢɜɧɟɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɢ ɪɚɫɱɟɬɧɨɝɨ ɨɛɴɟɦɚ ɞɨɠɞɟɜɵɯ"
    },
    {
      "index": 21,
      "bbox": [
        63.779,
        435.396,
        568.718,
        453.751
      ],
      "text": "ɫɬɨɤɨɜ ................................................................................................................................ 10"
    },
    {
      "index": 22,
      "bbox": [
        63.778,
        459.575,
        568.715,
        477.931
      ],
      "text": "ɟ)  Ɋɟɲɟɧɢɹ ɩɨ ɫɛɨɪɭ ɢ ɨɬɜɨɞɭ ɞɪɟɧɚɠɧɵɯ ɜɨɞ   .......................................................... 11"
    },
    {
