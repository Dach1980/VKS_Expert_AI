      ],
      "text": "ɋɈȾȿɊɀȺɇɂȿ"
    },
    {
      "index": 6,
      "bbox": [
        63.78,
        73.176,
        568.72,
        91.532
      ],
      "text": "ɋɩɢɫɨɤ ɢɫɩɨɥɧɢɬɟɥɟɣ ........................................................................................................ 2"
    },
    {
      "index": 7,
      "bbox": [
        63.78,
        97.356,
