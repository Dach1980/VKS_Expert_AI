      "bbox": [
        35.34,
        86.317,
        473.592,
        129.198
      ],
      "text": "1.ɉɨɫɬɚɧɨɜɥɟɧɢɟ ɊɎ ɨɬ 16.02.2008ɝ №87 «Ɉ ɫɨɫɬɚɜɟ ɪɚɡɞɟɥɨɜ ɩɪɨɟɤɬɧɨɣ"
    },
    {
      "index": 6,
      "bbox": [
        35.337,
        135.036,
        330.79,
        153.378
      ],
      "text": "ɞɨɤɭɦɟɧɬɚɰɢɢ ɢ ɬɪɟɛɨɜɚɧɢɹɯ ɤ ɢɯ ɫɨɞɟɪɠɚɧɢɸ»;"
    },
    {
      "index": 7,
      "bbox": [
        35.334,
        159.156,
        513.972,
        177.497
      ],
      "text": "2.ɋɉ 30.13330.2016 «ɋɇɢɉ 2.04.01-85* ȼɧɭɬɪɟɧɧɢɣ ɜɨɞɨɩɪɨɜɨɞ ɢ ɤɚɧɚɥɢɡɚɰɢɹ"
    },
    {
