      "bbox": [
        35.337,
        183.335,
        91.093,
        201.677
      ],
      "text": "ɡɞɚɧɢɣ»;"
    },
    {
      "index": 9,
      "bbox": [
        35.337,
        207.455,
        481.573,
        225.797
      ],
      "text": "3.ɋɉ 112.13330.2011 «ɋɇɢɉ 21-01-97* «ɉɨɠɚɪɧɚɹ ɛɟɡɨɩɚɫɧɨɫɬɶ ɡɞɚɧɢɣ ɢ"
    },
    {
      "index": 10,
      "bbox": [
        35.339,
        231.635,
        122.294,
        249.977
      ],
      "text": "ɫɨɨɪɭɠɟɧɢɣ»;"
    },
    {
      "index": 11,
      "bbox": [
        35.339,
        255.754,
        514.932,
        274.096
      ],
      "text": "4.ɋɉ 8.13130.2020 «ɋɢɫɬɟɦɵ ɩɪɨɬɢɜɨɩɨɠɚɪɧɨɣ ɡɚɳɢɬɵ. ɂɫɬɨɱɧɢɤɢ ɧɚɪɭɠɧɨɝɨ"
    },
    {
      "index": 12,
      "bbox": [
        35.337,
        279.935,
        482.232,
        298.276
      ],
      "text": "ɩɪɨɬɢɜɨɩɨɠɚɪɧɨɝɨ ɜɨɞɨɫɧɚɛɠɟɧɢɹ. Ɍɪɟɛɨɜɚɧɢɹ ɩɨɠɚɪɧɨɣ ɛɟɡɨɩɚɫɧɨɫɬɢ»;"
    },
    {
      "index": 13,
      "bbox": [
        35.336,
        304.054,
        454.21,
        322.396
      ],
      "text": "5.ɋɉ 10.13130.2009 ɋɢɫɬɟɦɵ ɩɪɨɬɢɜɨɩɨɠɚɪɧɨɣ ɡɚɳɢɬɵ. ȼɧɭɬɪɟɧɧɢɣ"
    },
    {
      "index": 14,
      "bbox": [
        35.336,
        328.234,
        450.315,
        346.578
      ],
      "text": "ɩɪɨɬɢɜɨɩɨɠɚɪɧɵɣ ɜɨɞɨɩɪɨɜɨɞ. Ɍɪɟɛɨɜɚɧɢɹ ɩɨɠɚɪɧɨɣ ɛɟɡɨɩɚɫɧɨɫɬɢ;"
    },
    {
      "index": 15,
      "bbox": [
        35.339,
        352.356,
        495.131,
        370.698
      ],
      "text": "6. ɋɉ 73.13330.2016 «ȼɧɭɬɪɟɧɧɢɟ ɫɚɧɢɬɚɪɧɨ-ɬɟɯɧɢɱɟɫɤɢɟ ɫɢɫɬɟɦɵ ɡɞɚɧɢɣ»."
    },
    {
      "index": 16,
      "bbox": [
        35.337,
        376.536,
        520.873,
        394.878
      ],
      "text": "7. ɋɉ 30.13330.2012 «ɋɇɢɉ 2.04.01 -85* ȼɧɭɬɪɟɧɧɢɣ ɜɨɞɨɩɪɨɜɨɞ ɢ ɤɚɧɚɥɢɡɚɰɢɹ"
    },
    {
      "index": 17,
      "bbox": [
        35.338,
        400.655,
        91.094,
        418.997
      ],
      "text": "ɡɞɚɧɢɣ»;"
    },
    {
      "index": 18,
      "bbox": [
        35.338,
        424.775,
        509.113,
        443.118
      ],
      "text": "8. ɉɨɫɬɚɧɨɜɥɟɧɢɟ ɩɪɚɜɢɬɟɥɶɫɬɜɚ  ɊɎ ɨɬ 04.07.2020 ɝ.  № 985 «Ɉɛ ɭɬɜɟɪɠɞɟɧɢɢ"
    },
    {
      "index": 19,
      "bbox": [
        35.338,
        448.956,
        518.83,
        467.298
      ],
      "text": "ɩɟɪɟɱɧɹ ɧɚɰɢɨɧɚɥɶɧɵɯ ɫɬɚɧɞɚɪɬɨɜ ɢ ɫɜɨɞɨɜ ɩɪɚɜɢɥ (ɱɚɫɬɟɣ ɬɚɤɢɯ ɫɬɚɧɞɚɪɬɨɜ ɢ"
    },
    {
      "index": 20,
      "bbox": [
        35.336,
        473.076,
        484.449,
        491.417
      ],
      "text": "ɫɜɨɞɨɜ ɩɪɚɜɢɥ) ɜ ɪɟɡɭɥɶɬɚɬɟ ɩɪɢɦɟɧɟɧɢɹ ɤɨɬɨɪɵɯ ɧɚ ɨɛɹɡɚɬɟɥɶɧɨɣ  ɨɫɧɨɜɟ"
    },
    {
      "index": 21,
      "bbox": [
        35.334,
        497.256,
        496.689,
        515.597
      ],
      "text": "ɨɛɟɫɩɟɱɢɜɚɟɬɫɹ ɫɨɛɥɸɞɟɧɢɟ ɬɪɟɛɨɜɚɧɢɣ ɮɟɞɟɪɚɥɶɧɨɝɨ ɡɚɤɨɧɚ «Ɍɟɯɧɢɱɟɫɤɢɣ"
    },
    {
      "index": 22,
      "bbox": [
        35.334,
        521.375,
        336.126,
        539.717
      ],
      "text": "ɪɟɝɥɚɦɟɧɬ ɨ ɛɟɡɨɩɚɫɧɨɫɬɢ ɡɞɚɧɢɣ ɢ ɫɨɨɪɭɠɟɧɢɣ»."
    }
