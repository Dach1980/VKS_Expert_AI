      ],
      "text": "Инв. №0039-20 35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1"
    },
    {
      "index": 2,
      "bbox": [
        23.28,
        808.664,
        417.718,
        826.157
      ],
      "text": "8 \n«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 3,
      "bbox": [
        35.34,
        41.376,
        538.518,
        59.718
      ],
      "text": "ɋɨɝɥɚɫɧɨ ɋɉ 32.13330.2018 ɩ.9.1.5 ɤɨɥɢɱɟɫɬɜɨ ɡɚɝɪɹɡɧɹɸɳɢɯ ɜɟɳɟɫɬɜ ɜ"
    },
    {
      "index": 4,
      "bbox": [
        35.343,
        65.556,
        290.179,
        83.898
      ],
      "text": "ɛɵɬɨɜɵɯ ɫɬɨɤɚɯ ɧɚ 1 ɱɟɥɨɜɟɤɚ ɫɨɫɬɚɜɥɹɟɬ:"
    },
    {
      "index": 5,
      "bbox": [
        92.463,
        90.696,
        309.318,
        109.038
      ],
      "text": " ɜɡɜɟɲɟɧɧɵɟ ɜɟɳɟɫɬɜɚ – 65 ɝ/ɫɭɬ;"
    },
    {
      "index": 6,
      "bbox": [
        92.461,
        115.836,
        391.636,
        134.178
      ],
      "text": " ȻɉɄɩɨɥɧ. ɧɟɨɫɜɟɬɥɟɧɧɨɣ ɠɢɞɤɨɫɬɢ – 75 ɝ/ɫɭɬ;"
    },
    {
      "index": 7,
      "bbox": [
        92.46,
        141.037,
        378.014,
        159.378
      ],
      "text": " ȻɉɄɩɨɥɧ. ɨɫɜɟɬɥɟɧɧɨɣ ɠɢɞɤɨɫɬɢ – 40 ɝ/ɫɭɬ;"
    },
    {
      "index": 8,
      "bbox": [
        92.457,
        166.177,
        331.873,
        184.519
      ],
      "text": " Ⱥɡɨɬ ɚɦɦɨɧɢɣɧɵɯ ɫɨɥɟɣ N – 8 ɝ/ɫɭɬ;"
    },
    {
      "index": 9,
      "bbox": [
        92.456,
        191.317,
        272.292,
        209.659
      ],
      "text": " Ɏɨɫɮɚɬɵ P2O5 – 3.3 ɝ/ɫɭɬ;"
    },
    {
      "index": 10,
      "bbox": [
        92.454,
        216.457,
        378.008,
        234.799
      ],
      "text": " ȼ ɬɨɦ ɱɢɫɥɟ ɨɬ ɦɨɸɳɢɯ ɜɟɳɟɫɬɜ – 1.6 ɝ/ɫɭɬ;"
    },
    {
      "index": 11,
      "bbox": [
        92.451,
        241.596,
        243.198,
        259.939
      ],
      "text": " ɏɥɨɪɢɞɵ Cl – 9 ɝ/ɫɭɬ;"
    },
    {
      "index": 12,
      "bbox": [
        92.461,
        266.796,
        216.795,
        285.138
      ],
      "text": " ɋɉȺȼ – 2.5 ɝ/ɫɭɬ"
    },
    {
      "index": 14,
      "bbox": [
        35.34,
        315.035,
        534.975,
        333.377
      ],
      "text": "Ɋɚɫɱɟɬɧɨɟ ɤɨɥɢɱɟɫɬɜɨ ɛɵɬɨɜɵɯ ɫɬɨɤɨɜ ɨɬ  ɡɞɚɧɢɣ, ɩɨɫɬɭɩɚɸɳɢɯ  ɜ"
    },
    {
      "index": 15,
      "bbox": [
        35.34,
        339.215,
        439.995,
        357.557
      ],
      "text": "ɧɚɪɭɠɧɵɟ ɫɟɬɢ ɤɚɧɚɥɢɡɚɰɢɢ,  ɫɨɫɬɚɜɢɬ 8,48 ɦ3/ɫɭɬ, 2103,04 ɦ3/ɝɨɞ."
    },
    {
      "index": 16,
      "bbox": [
        35.34,
        363.335,
        534.98,
        381.677
      ],
      "text": "ɉɨ ɫɨɫɬɚɜɭ ɡɚɝɪɹɡɧɟɧɢɣ ɛɵɬɨɜɵɟ ɫɬɨɱɧɵɟ ɜɨɞɵ ɫɨɨɬɜɟɬɫɬɜɭɸɬ ɢ ɧɟ"
    },
    {
      "index": 17,
      "bbox": [
        35.344,
        387.515,
        534.979,
        405.857
      ],
      "text": "ɩɪɟɜɵɲɚɸɬ ɤɨɧɰɟɧɬɪɚɰɢɸ ɡɚɝɪɹɡɧɟɧɢɣ, ɪɚɡɪɟɲɟɧɧɵɯ ɤ ɫɛɪɨɫɭ ɜ ɧɚɪɭɠɧɵɟ ɫɟɬɢ"
    },
    {
      "index": 18,
      "bbox": [
        35.343,
        411.635,
        534.976,
        429.977
      ],
      "text": "ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɫ ɩɨɫɥɟɞɭɸɳɢɦ ɨɬɜɟɞɟɧɢɟɦ ɢɯ ɧɚ ɝɨɪɨɞɫɤɢɟ ɨɱɢɫɬɧɵɟ"
    },
    {
      "index": 19,
      "bbox": [
        35.339,
        435.816,
        352.394,
        454.158
      ],
      "text": "ɫɨɨɪɭɠɟɧɢɹ. Ⱦɨɩɨɥɧɢɬɟɥɶɧɨɣ ɨɱɢɫɬɤɢ ɧɟ ɬɪɟɛɭɟɬɫɹ."
    },
    {
      "index": 22,
      "bbox": [
        75.36,
        509.831,
        494.46,
        528.438
      ],
      "text": "ɜ)    ɈȻɈɋɇɈȼȺɇɂȿ ɉɊɂɇəɌɈȽɈ ɉɈɊəȾɄȺ ɋȻɈɊȺ, ɍɌɂɅɂɁȺɐɂɂ ɂ"
    },
    {
      "index": 23,
      "bbox": [
        204.24,
        526.02,
        365.52,
        541.992
      ],
      "text": "ɁȺɏɈɊɈɇȿɇɂə ɈɌɏɈȾɈȼ"
    },
    {
      "index": 24,
      "bbox": [
        35.34,
        554.818,
        443.353,
        583.938
      ],
      "text": "ɋɛɨɪ, ɭɬɢɥɢɡɚɰɢɹ ɢ ɡɚɯɨɪɨɧɟɧɢɟ ɨɬɯɨɞɨɜ ɜ ɞɚɧɧɨɦ ɩɪɨɟɤɬɟ ɧɟ"
    },
    {
      "index": 25,
      "bbox": [
        35.338,
        589.716,
        164.592,
        608.057
      ],
      "text": "ɩɪɟɞɭɫɦɚɬɪɢɜɚɸɬɫɹ."
    },
    {
      "index": 28,
      "bbox": [
        47.04,
        665.831,
        522.78,
        684.438
      ],
      "text": "ɝ)  ɈɉɂɋȺɇɂȿ ɂ ɈȻɈɋɇɈȼȺɇɂȿ ɋɏȿɆɕ ɉɊɈɄɅȺȾɄɂ ɄȺɇȺɅɂɁȺɐɂɈɇɇɕɏ"
    },
    {
      "index": 29,
      "bbox": [
        74.04,
        682.02,
        495.72,
        697.992
      ],
      "text": "ɌɊɍȻɈɉɊɈȼɈȾɈȼ, ɈɉɂɋȺɇɂȿ ɍɑȺɋɌɄɈȼ ɉɊɈɄɅȺȾɄɂ ɇȺɉɈɊɇɕɏ"
    },
    {
      "index": 30,
      "bbox": [
        46.86,
        695.82,
        522.96,
        725.592
      ],
      "text": "ɌɊɍȻɈɉɊɈȼɈȾɈȼ (ɉɊɂ ɇȺɅɂɑɂɂ), ɍɋɅɈȼɂə ɂɏ ɉɊɈɄɅȺȾɄɂ, \nɈȻɈɊɍȾɈȼȺɇɂȿ, ɋȼȿȾȿɇɂə Ɉ ɆȺɌȿɊɂȺɅȿ ɌɊɍȻɈɉɊɈȼɈȾɈȼ ɂ ɄɈɅɈȾɐȿȼ,"
    },
    {
      "index": 31,
      "bbox": [
        63.24,
        723.42,
        506.58,
        739.392
      ],
      "text": "ɋɉɈɋɈȻɕ ɂɏ ɁȺɓɂɌɕ ɈɌ ȺȽɊȿɋɋɂȼɇɈȽɈ ȼɈɁȾȿɃɋɌȼɂə ȽɊɍɇɌɈȼ ɂ"
    },
    {
      "index": 32,
      "bbox": [
        229.68,
        737.22,
        340.14,
        753.192
      ],
      "text": "ȽɊɍɇɌɈȼɕɏ ȼɈȾ"
    }
  ],
  "formulas": []
}