      "text": "Инв. №0039-20 35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1"
    },
    {
      "index": 2,
      "bbox": [
        23.28,
        808.664,
        417.718,
        826.157
      ],
      "text": "10 \n«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 3,
      "bbox": [
        35.34,
        41.376,
        534.98,
        59.718
      ],
      "text": "ɬɪɭɛɨɩɪɨɜɨɞɨɜ ɢɡ ɩɨɥɢɩɪɨɩɢɥɟɧɨɜɵɯ ɬɪɭɛ ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ ɜ ɫɨɨɬɜɟɬɫɬɜɢɢ ɫ"
    },
    {
      "index": 4,
      "bbox": [
        35.344,
        65.556,
        225.098,
        83.898
      ],
      "text": "ɬɪɟɛɨɜɚɧɢɹɦɢ ɋɉ 40-107-2003."
    },
    {
      "index": 5,
      "bbox": [
        77.885,
        89.675,
        534.978,
        108.017
      ],
      "text": "ɋɢɫɬɟɦɚ  ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɜɵɲɟ ɨɬɦ. 0.000 ɦɨɧɬɢɪɭɟɬɫɹ ɢɡ"
    },
    {
      "index": 6,
      "bbox": [
        35.343,
        84.658,
        534.976,
        162.652
      ],
      "text": "ɩɨɥɢɩɪɨɩɢɥɟɧɨɜɵɯ  ɬɪɭɛ ∅50-110 ɦɦ ɩɨ Ɍɍ 4926-005-41989945-97.    ɇɢɠɟ ɨɬɦ."
    },
    {
      "index": 7,
      "bbox": [
        35.341,
        138.456,
        534.977,
        156.798
      ],
      "text": "0.000 ɩɨɞ ɩɨɥɨɦ 1-ɝɨ ɷɬɚɠɚ ɤɚɧɚɥɢɡɚɰɢɨɧɧɵɟ ɫɟɬɢ ɢ ɜɵɩɭɫɤɢ ɩɪɟɞɭɫɦɨɬɪɟɧɵ ɢɡ"
    },
    {
      "index": 8,
      "bbox": [
        35.342,
        162.576,
        534.976,
        180.917
      ],
      "text": "ɩɨɥɢɩɪɨɩɢɥɟɧɨɜɵɯ ɭɫɢɥɟɧɧɵɯ ɬɪɭɛ \"ɉɈɅɂɌЭɄ 2000\" ɞɥɹ  ɧɚɪɭɠɧɨɣ"
    },
    {
      "index": 9,
      "bbox": [
        35.34,
        157.558,
        534.973,
        235.552
      ],
      "text": "ɤɚɧɚɥɢɡɚɰɢɢ \n∅110 \nɦɦ \nɩɨ \nɌɍ \n2248-010-52384398-2003. \nɇɚ \nɜɵɩɭɫɤɚɯ"
    },
    {
      "index": 10,
      "bbox": [
        35.337,
        182.158,
        534.975,
        260.152
      ],
      "text": "ɩɪɟɞɭɫɦɨɬɪɟɧɵ ɮɭɬɥɹɪɵ ɢɡ ɫɬɚɥɶɧɵɯ ɬɪɭɛ ∅219ɯ6  ɩɨ ȽɈɋɌ10704-91 ɫ ɧɚɪɭɠɧɵɦ"
    },
    {
      "index": 11,
      "bbox": [
        35.34,
        235.956,
        531.522,
        254.298
      ],
      "text": "ɚɧɬɢɤɨɪɪɨɡɢɨɧɧɵɦ ɩɨɤɪɵɬɢɟɦ ɧɚ ɨɫɧɨɜɟ ɩɨɥɢɷɬɢɥɟɧɨɜɵɯ ɥɟɧɬ Ɍɍ 1390-001-"
    },
    {
      "index": 12,
      "bbox": [
        35.342,
        260.136,
        534.976,
        278.478
      ],
      "text": "0912803-2012 (ɩɨɤɪɵɬɢɟ ɫɨɨɬɜɟɬɫɬɜɭɟɬ ɭɫɢɥɟɧɧɨɦɭ ɬɢɩɭ ɩɨ ȽɈɋɌ 9.602-2016), ɫ"
    },
    {
      "index": 13,
      "bbox": [
        35.341,
        284.255,
        453.674,
        302.597
      ],
      "text": "ɡɚɞɟɥɤɨɣ ɤɨɧɰɨɜ ɮɭɬɥɹɪɚ ɩɥɨɬɧɵɦ ɜɨɞɨɧɟɩɪɨɧɢɰɚɟɦɵɦ ɦɚɬɟɪɢɚɥɨɦ."
    },
    {
      "index": 14,
      "bbox": [
        77.88,
        308.436,
        534.971,
        326.777
      ],
      "text": "Ɍɟɯɧɢɱɟɫɤɢɟ ɪɟɲɟɧɢɹ ɩɨ ɩɪɨɤɥɚɞɤɟ ɢ ɦɚɬɟɪɢɚɥɭ ɬɪɭɛ ɫɢɫɬɟɦɵ ɛɵɬɨɜɨɣ"
    },
    {
      "index": 15,
      "bbox": [
        35.335,
        332.555,
        531.448,
        350.897
      ],
      "text": "ɤɚɧɚɥɢɡɚɰɢɢ ɞɥɹ ɡɞɚɧɢɹ Ʉɉɉ ɚɧɚɥɨɝɢɱɧɵ ɪɟɲɟɧɢɹɦ ɩɨ ɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-"
    },
    {
      "index": 16,
      "bbox": [
        35.333,
        356.735,
        215.047,
        375.076
      ],
      "text": "ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɦɭ ɤɨɪɩɭɫɭ."
    },
    {
      "index": 17,
      "bbox": [
        77.872,
        380.855,
        534.974,
        399.198
      ],
      "text": "ɉɪɨɟɤɬɧɵɟ \nɪɟɲɟɧɢɹ \nɩɨ \nɩɪɨɤɥɚɞɤɟ \nɜɧɭɬɪɢɩɥɨɳɚɞɨɱɧɵɯ \nɫɟɬɟɣ"
    },
    {
      "index": 18,
      "bbox": [
        35.339,
        405.036,
        531.452,
        423.378
      ],
      "text": "ɜɨɞɨɨɬɜɟɞɟɧɢɹ ɩɨ ɬɟɪɪɢɬɨɪɢɢ ɩɥɨɳɚɞɤɢ ɫɦ. ɱɚɫɬɶ 35020Ɋ040002.111.20.ɋ.ɏȺȻ-"
    },
    {
      "index": 19,
      "bbox": [
        35.337,
        429.155,
        187.329,
        447.497
      ],
      "text": "ɂɈɋ3.2 (ɢɧɜ.№0040-20)."
    },
    {
      "index": 22,
      "bbox": [
        56.996,
        513.55,
        512.821,
        532.157
      ],
      "text": "ɞ)  Ɋȿɒȿɇɂȿ ȼ ɈɌɇɈɒȿɇɂɂ ɅɂȼɇȿȼɈɃ ɄȺɇȺɅɂɁȺɐɂɂ ɂ ɊȺɋɑȿɌɇɈȽɈ"
    },
    {
      "index": 23,
      "bbox": [
        190.081,
        529.739,
        379.681,
        545.711
      ],
      "text": "ɈȻɔȿɆȺ ȾɈɀȾȿȼɕɏ ɋɌɈɄɈȼ"
    },
    {
      "index": 25,
      "bbox": [
        77.882,
        585.635,
        538.521,
        603.977
      ],
      "text": "ɉɨɞɤɥɸɱɟɧɢɟ ɨɛɴɟɤɬɚ ɤ ɫɟɬɹɦ ɞɨɠɞɟɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɜɵɩɨɥɧɟɧɨ, ɫɨɝɥɚɫɧɨ"
    },
    {
      "index": 26,
      "bbox": [
        35.347,
        609.815,
        534.981,
        628.157
      ],
      "text": "ɡɚɞɚɧɢɸ ɧɚ ɩɪɨɟɤɬɢɪɨɜɚɧɢɟ. Ɉɬɜɟɞɟɧɢɟ  ɩɨɜɟɪɯɧɨɫɬɧɵɯ ɞɨɠɞɟɜɵɯ ɫɬɨɤɨɜ ɫ"
    },
    {
      "index": 27,
      "bbox": [
        35.345,
        633.935,
        534.981,
        652.276
      ],
      "text": "ɬɟɪɪɢɬɨɪɢɢ, \nɩɪɢɥɟɝɚɸɳɟɣ \nɤ \nɩɪɨɢɡɜɨɞɫɬɜɟɧɧɨ-ɚɞɦɢɧɢɫɬɪɚɬɢɜɧɨɦɭ \nɡɞɚɧɢɸ"
    },
    {
      "index": 28,
      "bbox": [
        35.346,
        658.114,
        534.98,
        676.456
      ],
      "text": "ɩɪɟɞɭɫɦɨɬɪɟɧɨ ɜɟɪɬɢɤɚɥɶɧɨɣ ɩɥɚɧɢɪɨɜɤɨɣ ɪɟɥɶɟɮɚ ɤ ɞɨɠɞɟɩɪɢɟɦɧɢɤɚɦ ɢ ɞɚɥɟɟ"
    },
    {
      "index": 29,
      "bbox": [
        35.344,
        682.234,
        534.978,
        700.576
      ],
      "text": "ɩɨ ɩɪɨɟɤɬɢɪɭɟɦɵɦ ɡɚɤɪɵɬɵɦ ɫɟɬɹɦ ɞɨɠɞɟɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɜ ɛɥɢɠɚɣɲɢɣ"
    },
    {
      "index": 30,
      "bbox": [
        35.343,
        706.414,
        534.976,
        724.756
      ],
      "text": "ɫɭɳɟɫɬɜɭɸɳɢɣ ɤɨɥɨɞɟɰ ɫɭɳɟɫɬɜɭɸɳɟɣ ɝɨɪɨɞɫɤɨɣ ɫɟɬɢ ɞɨɠɞɟɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ  ɩɨ"
    },
    {
      "index": 31,
      "bbox": [
        35.34,
        730.533,
        514.271,
        748.877
      ],
      "text": "ɭɥ. ɋɢɞɨɪɟɧɤɨ, ɫɦ. ɱɚɫɬɶ 35020Ɋ040002.111.20.ɋ.ɏȺȻ-ɂɈɋ3.2 (ɢɧɜ.№0040-20)."
    }
  ],
