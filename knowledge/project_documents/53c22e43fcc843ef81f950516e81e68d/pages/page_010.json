        566.846,
        31.487
      ],
      "text": "ɚɬɟɝɨɪɢɢ \n35020Ɋ040002.111.20.ɋ.ХȺȻ-ИОɋ3.1                                                                                          Инв. №0039-20"
    },
    {
      "index": 3,
      "bbox": [
        177.66,
        808.664,
        503.776,
        819.78
      ],
      "text": "«ɉɊɈɂɁȼɈȾɋɌȼȿɇɇɈ-ȺȾɆɂɇɂɋɌɊȺɌɂȼɇɈȿ ɁȾȺɇɂȿ ɉɅɈЩȺȾɄɂ «ɊȺɄɂɌɇɈȿ»"
    },
    {
      "index": 4,
      "bbox": [
        565.62,
        814.217,
        574.536,
        826.217
      ],
      "text": "9"
    },
    {
      "index": 5,
      "bbox": [
        106.32,
        41.376,
        563.415,
        59.718
      ],
      "text": "Ʉɚɧɚɥɢɡɚɰɢɨɧɧɵɟ ɨɬɜɨɞɧɵɟ ɬɪɭɛɨɩɪɨɜɨɞɵ ɨɬ ɩɪɢɛɨɪɨɜ ɩɪɨɤɥɚɞɵɜɚɸɬɫɹ"
    },
    {
      "index": 6,
      "bbox": [
        63.78,
        65.556,
        563.414,
        83.898
      ],
      "text": "ɩɨ ɫɬɟɧɚɦ ɫɚɧɭɡɥɨɜ. ɋɨɝɥɚɫɧɨ ɩ. 8.2.8 ɋɉ 30.13330.2012, ɩɪɢ ɩɪɢɦɟɧɟɧɢɢ ɬɪɭɛ ɢɡ"
    },
    {
      "index": 7,
      "bbox": [
        63.778,
        89.675,
        563.407,
        108.017
      ],
      "text": "ɩɨɥɢɦɟɪɧɵɯ ɦɚɬɟɪɢɚɥɨɜ ɞɥɹ ɫɢɫɬɟɦɵ ɜɧɭɬɪɟɧɧɟɣ ɤɚɧɚɥɢɡɚɰɢɢ ɩɪɨɤɥɚɞɤɚ ɫɬɨɹɤɨɜ"
    },
    {
      "index": 8,
      "bbox": [
        63.772,
        113.855,
        563.41,
        132.197
      ],
      "text": "ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ \nɫɤɪɵɬɚɹ \nɜ \nɦɨɧɬɚɠɧɵɯ \nɤɨɦɦɭɧɢɤɚɰɢɨɧɧɵɯ \nɤɨɪɨɛɚɯ,"
    },
    {
      "index": 9,
      "bbox": [
        63.776,
        137.975,
        563.41,
        156.317
      ],
      "text": "ɨɝɪɚɠɞɚɸɳɢɟ ɤɨɧɫɬɪɭɤɰɢɢ ɤɨɬɨɪɵɯ ɜɵɩɨɥɧɹɸɬɫɹ ɢɡ ɧɟɝɨɪɸɱɢɯ ɦɚɬɟɪɢɚɥɨɜ, ɡɚ"
    },
    {
      "index": 10,
      "bbox": [
        63.775,
        162.094,
        563.409,
        180.436
      ],
      "text": "ɢɫɤɥɸɱɟɧɢɟɦ ɥɢɰɟɜɨɣ ɩɚɧɟɥɢ, ɨɛɟɫɩɟɱɢɜɚɸɳɟɣ ɞɨɫɬɭɩ ɤ ɫɬɨɹɤɚɦ. Ʌɢɰɟɜɚɹ ɩɚɧɟɥɶ"
    },
    {
      "index": 11,
      "bbox": [
        63.774,
        186.275,
        563.412,
        204.618
      ],
      "text": "ɢɡɝɨɬɚɜɥɢɜɚɟɬɫɹ ɜ ɜɢɞɟ ɞɜɟɪɢ ɢɡ ɝɨɪɸɱɢɯ ɦɚɬɟɪɢɚɥɨɜ, ɝɪɭɩɩɵ ɝɨɪɸɱɟɫɬɢ ɧɟ ɧɢɠɟ"
    },
    {
      "index": 12,
      "bbox": [
        63.776,
        210.396,
        570.369,
        228.737
      ],
      "text": "Ƚ2. ɉɪɟɞɭɫɦɨɬɪɟɧɚ ɡɚɞɟɥɤɚ ɫɬɨɹɤɨɜ  ɱɟɪɟɡ ɩɟɪɟɤɪɵɬɢɹ  ɰɟɦɟɧɬɧɵɦ ɪɚɫɬɜɨɪɨɦ ɫ"
    },
    {
      "index": 13,
      "bbox": [
        63.775,
        234.575,
        563.413,
        252.917
      ],
      "text": "ɨɛɟɪɬɤɨɣ ɬɪɭɛɵ ɪɭɛɟɪɨɢɞɨɦ, ɭɱɚɫɬɨɤ ɫɬɨɹɤɚ ɜɵɲɟ ɩɟɪɟɤɪɵɬɢɹ ɧɚ 8-10ɫɦ (ɞɨ"
    },
    {
      "index": 14,
      "bbox": [
        63.778,
        258.695,
        566.895,
        277.037
      ],
      "text": "ɝɨɪɢɡɨɧɬɚɥɶɧɨɝɨ ɨɬɜɨɞɚ ɬɪɭɛɨɩɪɨɜɨɞɚ) ɡɚɳɢɬɢɬɶ  ɰɟɦɟɧɬɧɵɦ ɪɚɫɬɜɨɪɨɦ  t=2-3ɫɦ"
    },
    {
      "index": 15,
      "bbox": [
        63.78,
        282.875,
        410.271,
        301.217
      ],
      "text": "ɜ ɫɨɨɬɜɟɬɫɬɜɢɢ ɫ ɬɪɟɛɨɜɚɧɢɹɦɢ ɩ.8.2.8 ɋɉ 30.13330.2012."
    },
    {
      "index": 16,
      "bbox": [
        106.32,
        306.994,
        563.416,
        325.336
      ],
      "text": "ȼ \nɦɟɫɬɚɯ \nɩɟɪɟɫɟɱɟɧɢɹ \nɫɬɨɹɤɚɦɢ \nɩɟɪɟɤɪɵɬɢɣ \nɭɫɬɚɧɚɜɥɢɜɚɸɬɫɹ"
    },
    {
      "index": 17,
      "bbox": [
        63.781,
        331.175,
        563.411,
        349.518
      ],
      "text": "ɩɪɨɬɢɜɨɩɨɠɚɪɧɵɟ ɦɭɮɬɵ \"Ɉɝɧɟɛɚɪɶɟɪ-Ɇɉ\" ɫɨ ɜɫɩɭɱɢɜɚɸɳɢɦɫɹ ɨɝɧɟɡɚɳɢɬɧɵɦ"
    },
    {
      "index": 18,
      "bbox": [
        63.776,
        355.296,
        471.246,
        373.637
      ],
      "text": "ɫɨɫɬɚɜɨɦ, ɩɪɟɩɹɬɫɬɜɭɸɳɢɦ ɪɚɫɩɪɨɫɬɪɚɧɟɧɢɸ ɩɥɚɦɟɧɢ  ɩɨ ɷɬɚɠɚɦ."
    },
    {
      "index": 19,
      "bbox": [
        106.312,
        379.475,
        563.41,
        397.817
      ],
      "text": "ɇɚ ɧɚɱɚɥɶɧɵɯ ɭɱɚɫɬɤɚɯ ɤɚɧɚɥɢɡɚɰɢɨɧɧɵɯ  ɝɨɪɢɡɨɧɬɚɥɶɧɵɯ ɬɪɭɛɨɩɪɨɜɨɞɨɜ"
    },
    {
      "index": 20,
      "bbox": [
        63.774,
        403.595,
        570.469,
        421.937
      ],
      "text": "ɞɥɹ ɢɫɤɥɸɱɟɧɢɹ ɡɚɫɚɫɵɜɚɸɳɟɝɨ ɷɮɮɟɤɬɚ ɩɪɟɞɭɫɦɨɬɪɟɧɵ ɜɨɡɞɭɲɧɵɟ ɤɥɚɩɚɧɵ HL."
    },
    {
      "index": 21,
      "bbox": [
        63.776,
        427.775,
        563.409,
        446.117
      ],
      "text": "Ɍɪɚɩɵ ɜ ɡɞɚɧɢɢ ɭɫɬɚɧɨɜɥɟɧɵ ɜ ɫɨɨɬɜɟɬɫɬɜɢɢ ɫ ɩ. 8.4.3 ɋɉ 30.13330.2012. ȼ"
    },
    {
      "index": 22,
      "bbox": [
        63.773,
        451.894,
        563.406,
        470.236
      ],
      "text": "ɬɟɯɧɢɱɟɫɤɢɯ ɩɨɦɟɳɟɧɢɹɯ ɜɨɞɨɦɟɪɧɨɝɨ ɭɡɥɚ, ɜɟɧɬɤɚɦɟɪɚɯ, ɤɨɦɩɪɟɫɫɨɪɧɨɣ,"
    },
    {
      "index": 23,
      "bbox": [
        63.771,
        476.074,
        563.408,
        494.416
      ],
      "text": "ɤɨɬɟɥɶɧɨɣ  ɭɫɬɚɧɚɜɥɢɜɚɸɬɫɹ ɬɪɚɩɵ ɫ «ɫɭɯɢɦ» ɫɢɮɨɧɨɦ ɞɥɹ ɡɚɩɢɪɚɧɢɹ ɡɚɩɚɯɚ ɩɪɢ"
    },
    {
      "index": 24,
      "bbox": [
        63.773,
        500.194,
        310.046,
        518.536
      ],
      "text": "ɜɨɡɦɨɠɧɨɦ ɩɟɪɟɫɵɯɚɧɢɢ ɝɢɞɪɨɡɚɬɜɨɪɚ."
    },
    {
      "index": 25,
      "bbox": [
        106.318,
        524.316,
        563.418,
        542.658
      ],
      "text": "Ɍɪɭɛɨɩɪɨɜɨɞɵ ɤɚɧɚɥɢɡɚɰɢɢ ɩɪɨɤɥɚɞɵɜɚɸɬɫɹ ɫ ɭɤɥɨɧɨɦ ɧɟ ɦɟɧɟɟ i=0,01"
    },
    {
      "index": 26,
      "bbox": [
        63.783,
        548.496,
        563.418,
        566.837
      ],
      "text": "ɩɪɢ Dɭ110 ɦɦ ɢ ɧɟ ɦɟɧɟɟ i=0,02 ɩɪɢ Dɭ=50 ɦɦ (ɩ. 8.3.2 ɋɉ 30.13330.2012). ɇɚ"
    },
    {
      "index": 27,
      "bbox": [
        63.783,
        572.615,
        563.422,
        590.957
      ],
      "text": "ɫɚɦɨɬɟɱɧɨɣ ɫɟɬɢ  ɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ  ɭɫɬɚɧɨɜɤɚ ɪɟɜɢɡɢɣ ɢ ɩɪɨɱɢɫɬɨɤ ɫɨɝɥɚɫɧɨ"
    },
    {
      "index": 28,
      "bbox": [
        63.787,
        596.795,
        563.422,
        615.137
      ],
      "text": "ɩ.ɩ. 8.2.23, 8.2.24 ɋɉ 30.13330.2012. ɋɟɬɶ ɛɵɬɨɜɨɣ ɤɚɧɚɥɢɡɚɰɢɢ ɡɞɚɧɢɹ"
    },
    {
      "index": 29,
      "bbox": [
        63.787,
        620.915,
        563.425,
        639.256
      ],
      "text": "ɜɟɧɬɢɥɢɪɭɟɬɫɹ ɱɟɪɟɡ ɜɵɬɹɠɧɵɟ ɭɱɚɫɬɤɢ ɫɬɨɹɤɨɜ, ɤɨɬɨɪɵɟ  ɜɵɜɟɞɟɧɵ ɜɵɲɟ ɤɪɨɜɥɢ"
    },
    {
      "index": 30,
      "bbox": [
        63.789,
        645.095,
        563.418,
        663.438
      ],
      "text": "ɧɚ 0,2 ɦ, ɫɨɝɥɚɫɧɨ ɩ. 8.2.15 ɋɉ 30.13330.2012. ɍɱɚɫɬɤɢ ɫɬɨɹɤɨɜ ɧɚ ɱɟɪɞɚɤɟ"
    },
    {
      "index": 31,
      "bbox": [
        63.783,
        669.215,
        563.415,
        687.557
      ],
      "text": "ɭɬɟɩɥɢɬɶ ɰɢɥɢɧɞɪɚɦɢ ɬɟɩɥɨɢɡɨɥɹɰɢɨɧɧɵɦɢ ɢɡ ɦɢɧɟɪɚɥɶɧɨɣ ɜɚɬɵ \"ROCKWOOL\""
    },
    {
      "index": 32,
      "bbox": [
        63.782,
        693.396,
        553.634,
        711.737
      ],
      "text": "ɩɨ Ɍɍ  5762-010-45757203-01 (ɝɪɭɩɩɚ ɝɨɪɸɱɟɫɬɢ ɇȽ), ɬɨɥɳɢɧɚ ɢɡɨɥɹɰɢɢ 100 ɦɦ."
    },
    {
      "index": 33,
      "bbox": [
        106.32,
        717.515,
        559.897,
        735.857
      ],
      "text": "Ⱦɥɹ ɤɨɦɩɟɧɫɚɰɢɢ ɫɬɪɨɢɬɟɥɶɧɵɯ ɞɨɩɭɫɤɨɜ, ɭɩɪɨɳɟɧɢɹ  ɦɨɧɬɚɠɧɨ-"
    },
    {
      "index": 34,
      "bbox": [
        63.781,
        741.695,
        566.898,
        760.036
      ],
      "text": "ɫɛɨɪɨɱɧɵɯ \nɢ \nɪɟɦɨɧɬɧɵɯ \nɪɚɛɨɬ \nɩɪɟɞɭɫɦɚɬɪɢɜɚɟɬɫɹ \nɩɪɢɦɟɧɟɧɢɟ"
    },
    {
      "index": 35,
      "bbox": [
        63.784,
        765.815,
        563.421,
        784.156
      ],
      "text": "ɤɨɦɩɟɧɫɚɰɢɨɧɧɨɝɨ ɩɚɬɪɭɛɤɚ ɧɚ ɫɬɨɹɤɚɯ ɧɚ  ɤɚɠɞɨɦ ɷɬɚɠɟ. Ʉɪɟɩɥɟɧɢɟ"
    }
  ],
  "formulas": []
}