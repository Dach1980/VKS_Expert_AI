{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normative_requirement.schema.json",
  "title": "Normative Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirement_id", "document", "clause", "requirement", "requirement_type"],
  "properties": {
    "requirement_id": {"type": "string"},
    "document": {"type": "string"},
    "version": {"type": "string"},
    "clause": {"type": "string"},
    "section": {"type": "string"},
    "requirement": {"type": "string"},
    "requirement_type": {
      "type": "string",
      "enum": ["mandatory", "conditional", "recommendation", "definition", "reference", "exception", "note", "table"]
    },
    "system": {"type": "string"},
    "segment": {"type": "string"},
    "object": {"type": "string"},
    "parameter": {"type": "string"},
    "condition": {"type": "string"},
    "exception": {"type": "string"},
    "normative_value": {"type": ["string", "number", "null"]},
    "normative_unit": {"type": ["string", "null"]},
    "source_page": {"type": ["integer", "null"], "minimum": 1}
  }
}
