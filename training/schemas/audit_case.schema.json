{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_case.schema.json",
  "title": "Engineering Audit Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "discipline", "check_id", "project_evidence", "normative_evidence", "decision", "decision_reason", "evidence_sufficient", "negative_case"],
  "properties": {
    "case_id": {"type": "string"},
    "discipline": {"type": "string"},
    "check_id": {"type": "string"},
    "project_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id"],
        "properties": {
          "fact_id": {"type": "string"},
          "source_page": {"type": ["integer", "null"], "minimum": 1},
          "evidence_text": {"type": "string"},
          "context": {"type": "string"}
        }
      }
    },
    "normative_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id"],
        "properties": {
          "requirement_id": {"type": "string"},
          "clause": {"type": "string"},
          "requirement_text": {"type": "string"},
          "requirement_type": {"type": "string"},
          "applicability_reason": {"type": "string"}
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string"},
        "segment": {"type": "string"},
        "object": {"type": "string"},
        "parameter": {"type": "string"},
        "applicable": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "expert_analysis": {"type": "string"},
    "decision": {
      "type": "string",
      "enum": ["compliant", "violation", "unchecked"]
    },
    "decision_reason": {"type": "string"},
    "evidence_sufficient": {"type": "boolean"},
    "negative_case": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
